# Copy to .env and fill in. .env is git-ignored.
# Org URL, not the -admin console URL. Use a free Integrator org, never a client org.
OKTA_ORG=https://integrator-1234567.okta.com

# Inbox you own. Test users become you+sara@... and you+omar@...
EMAIL_BASE=you@gmail.com

# Optional. Leave OKTA_TOKEN unset to be prompted with hidden input.
# OKTA_TOKEN=
# DEMO_PASSWORD=
# GROUP_NAME="App - Demo"
# APP_LABEL="SAML Test App (Demo)"
# POLICY_NAME="Demo - MFA required"
